{
  "schema_version": "training_recipe_v1",
  "recipe_id": "dpo_lora_v1",
  "algorithm": "dpo",
  "lora": {
    "source": "initial_checkpoint",
    "target_module_suffixes": ["q_proj", "v_proj"],
    "rank": 8,
    "alpha": 16.0,
    "dropout": 0.0
  },
  "tokenization": {
    "max_sequence_tokens": 3072,
    "truncation": false,
    "response_only": true,
    "supervise_assistant_terminator": true
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.00002,
    "weight_decay": 0.0,
    "max_grad_norm": 1.0
  },
  "training": {
    "epochs": 1,
    "micro_batch_units": 1,
    "gradient_accumulation_units": 8,
    "gradient_checkpointing": true,
    "resume_checkpoint_interval_steps": 25
  },
  "dpo": {
    "beta": 0.1,
    "label_smoothing": 0.0,
    "reference": "frozen_initial_checkpoint"
  },
  "smoke": {
    "units": 8,
    "optimizer_steps": 1,
    "selection": "longest_then_hash_spread"
  }
}
